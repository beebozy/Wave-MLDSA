# Copy to .env.local and fill in from your deployment.
# You can also enter these in the app's Settings panel (stored in the browser).
VITE_LOCK_CODE_HASH=0x...            # data1: the data_hash from migrations/*.json
VITE_LOCK_HASH_TYPE=data1
VITE_DEP_TX_HASH=0x...               # tx hash of the deployment cell
VITE_DEP_INDEX=0
# Optional: custom RPC (for example a local OffCKB devnet: http://127.0.0.1:28114)
# VITE_RPC_URL=
